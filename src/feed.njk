---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>{{ site.title }} — Writings</title>
    <link>{{ site.url }}/</link>
    <description>New writings from AJ Weeks</description>
    <language>en-us</language>
    {%- if collections.writings.length %}
    <lastBuildDate>{{ collections.writings[0].date.toUTCString() }}</lastBuildDate>
    {%- endif %}
    <atom:link href="{{ site.url }}/feed.xml" rel="self" type="application/rss+xml" />

    {%- for post in collections.writings %}
    <item>
      <title>{{ post.data.title | escape }}</title>
      <link>{{ site.url }}{{ post.url }}</link>
      <guid isPermaLink="true">{{ site.url }}{{ post.url }}</guid>
      <pubDate>{{ post.date.toUTCString() }}</pubDate>
      {% if post.data.description %}<description>{{ post.data.description | escape }}</description>{% endif %}
    </item>
    {%- endfor %}
  </channel>
</rss>
