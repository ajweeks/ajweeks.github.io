---
layout: base.njk
title: Writings
---

<h1>Writings</h1>

<ul class="post-list">
  {% for post in collections.writings %}
    <li>
      <time class="post-meta" datetime="{{ post.date | dateISO }}">{{ post.date | postDate }}</time>
      <a href="{{ post.url }}">{{ post.data.title }}</a>
    </li>
  {% endfor %}
</ul>
