---
layout: base.njk
title: Sitemap
permalink: /sitemap/
bodyClass: sitemap
---

<h1>Sitemap</h1>

<h2>Posts</h2>
<ul class="post-list">
  {%- for page in collections.all | sitemapPages("post") %}
    <li><a href="{{ page.url }}">{{ page.sitemapLabel }}</a></li>
  {%- endfor %}
</ul>

<h2>Games</h2>
<ul class="post-list">
  {%- for page in collections.all | sitemapPages("game") %}
    <li><a href="{{ page.url }}">{{ page.sitemapLabel }}</a></li>
  {%- endfor %}
</ul>

<h2>Other</h2>
<ul class="post-list">
  {%- for page in collections.all | sitemapPages("other") %}
    <li><a href="{{ page.url }}">{{ page.sitemapLabel }}</a></li>
  {%- endfor %}
</ul>
