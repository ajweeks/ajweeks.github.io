---
layout: base.njk
---

{% set translations = collections.post | translationsFor(translationKey) %}

<article lang="{{ lang or 'en' }}">
  <header>
    <h1>{{ title }}</h1>
    <time class="post-meta" datetime="{{ date | dateISO }}">{{ date | postDate }}</time>
    {% if translations.length > 1 %}
      <p class="post-translations">
        Available in:
        {% for t in translations %}
          {% if t.url == page.url %}<span class="post-translations-current">{{ t.data.lang | languageName }}</span>{% else %}<a href="{{ t.url }}">{{ t.data.lang | languageName }}</a>{% endif %}{% if not loop.last %} · {% endif %}
        {% endfor %}
      </p>
    {% endif %}
  </header>

  <div class="post-content">
    {{ content | safe }}
  </div>

  {% set adjacent = collections.post | adjacentPosts(page, translationKey) %}
  {% if adjacent.previous or adjacent.next %}
    <div class="post-navigation">
      {% if adjacent.previous %}
        <a href="{{ adjacent.previous.url }}" class="prev-post">← {{ adjacent.previous.data.title }}</a>
      {% else %}
        <span></span>
      {% endif %}
      {% if adjacent.next %}
        <a href="{{ adjacent.next.url }}" class="next-post">{{ adjacent.next.data.title }} →</a>
      {% else %}
        <span></span>
      {% endif %}
    </div>
  {% endif %}
</article>
