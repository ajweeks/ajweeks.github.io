{
  "name": "ajweeks.com",
  "version": "1.0.0",
  "private": true,
  "description": "Source for ajweeks.com (Eleventy)",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "eleventy --serve --port 8081",
    "build": "eleventy",
    "check:posts": ".venv/bin/python scripts/check_posts.py",
    "check:posts:fast": ".venv/bin/python scripts/check_posts.py --skip-links",
    "check:posts:links": ".venv/bin/python scripts/check_posts.py --skip-spelling",
    "images": ".venv/bin/python scripts/optimize_images.py"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "luxon": "^3.7.2"
  },
  "dependencies": {
    "markdown-it": "^15.0.3",
    "markdown-it-footnote": "^4.0.0"
  }
}
